
class Solution {
    public int getKthFromLast(Node head, int k) {
        Node temp = head;
        int count = 0;

        while (temp != null) {
            count++;
            temp = temp.next;
        }

        if (k > count || k <= 0) {
            return -1;
        }

        int position = count - k;
        temp = head;

        for (int i = 0; i < position; i++) {
            temp = temp.next;
        }

        return temp.data;
    }
}
